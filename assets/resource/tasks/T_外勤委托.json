{
    "task": [
        {
            "name": "外勤委托",
            "entry": "外勤委托",
            "option": [
                "开始前自动补足体力",
                "自动补足体力数值",
                "外勤区域",
                "外勤委托类型"
            ],
            "pipeline_override": {
                "Flag_体力判断": {
                    "custom_recognition_param": {
                        "ap_threshold": 40
                    }
                },
                "Action_智能策略补充": {
                    "custom_action_param": {
                        "ap_threshold": 40
                    }
                }
            },
            "description": "<span style=\"font-size:15px\">在指定区域内完成日常和庭审委托。外勤委托辩论失败后会再次辩论，直到体力用尽。</span>"
        }
    ],
    "option": {
        "自动补足体力数值": {
            "type": "input",
            "label": "自动补足体力数值",
            "inputs": [
                {
                    "name": "体力值",
                    "description": "填写自动补足体力的阈值",
                    "default": "40",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "pattern_msg": "体力值格式错误，请输入纯数字"
                }
            ],
            "pipeline_override": {
                "Flag_体力判断": {
                    "custom_recognition_param": {
                        "ap_threshold": "{体力值}"
                    }
                },
                "Action_智能策略补充": {
                    "custom_action_param": {
                        "ap_threshold": "{体力值}"
                    }
                }
            }
        },
        "外勤区域": {
            "type": "select",
            "cases": [
                {
                    "name": "滨河区",
                    "pipeline_override": {
                        "Click_进入外勤区域": {
                            "expected": [
                                "滨河区"
                            ]
                        }
                    }
                },
                {
                    "name": "锦兰区",
                    "pipeline_override": {
                        "Click_进入外勤区域": {
                            "expected": [
                                "锦兰区"
                            ]
                        }
                    }
                },
                {
                    "name": "长滩区",
                    "pipeline_override": {
                        "Click_进入外勤区域": {
                            "expected": [
                                "长滩区"
                            ]
                        }
                    }
                },
                {
                    "name": "嘉南区",
                    "pipeline_override": {
                        "Click_进入外勤区域": {
                            "expected": [
                                "嘉南区"
                            ]
                        }
                    }
                }
            ]
        },
        "外勤委托类型": {
            "type": "select",
            "cases": [
                {
                    "name": "高级委托",
                    "pipeline_override": {
                        "Flag_Inverse_委托类型": {
                            "expected": [
                                "高级"
                            ]
                        },
                        "Click_切换委托类型": {
                            "expected": [
                                "高级"
                            ]
                        }
                    }
                },
                {
                    "name": "初级委托",
                    "pipeline_override": {
                        "Flag_Inverse_委托类型": {
                            "expected": [
                                "初级"
                            ]
                        },
                        "Click_切换委托类型": {
                            "expected": [
                                "初级"
                            ]
                        }
                    }
                }
            ]
        }
    }
}