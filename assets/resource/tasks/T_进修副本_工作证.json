{
    "task": [
        {
            "name": "进修副本_工作证",
            "entry": "进修副本",
            "option": [
                "开始前自动补足体力",
                "进修关卡_工作证",
                "进修副本使用工作证张数"
            ],
            "description": "<span style=\"font-size:15px\">本功能是专门为使用工作证设计的。请先使用普通的进修副本复盘任务，将每日2次的次数使用完毕后再添加本任务，否则任务会出错</span><br><span style=\"font-size:15px\">复盘次数与工作证使用张数一样，不允许单独设置</span>"
        }
    ],
    "option": {
        "进修关卡_工作证": {
            "type": "select",
            "cases": [
                {
                    "name": "会展顾问（未名币）",
                    "pipeline_override": {
                        "Flag_进入进修副本": {
                            "expected": "会展顾问"
                        },
                        "Click_进入进修副本": {
                            "expected": "会展顾问"
                        },
                        "Click_进入进修关卡": {
                            "expected": "05"
                        }
                    }
                },
                {
                    "name": "业务考核（思绪经验）",
                    "pipeline_override": {
                        "Flag_进入进修副本": {
                            "expected": "业务考核"
                        },
                        "Click_进入进修副本": {
                            "expected": "业务考核"
                        },
                        "Click_进入进修关卡": {
                            "expected": "05"
                        }
                    }
                }
            ]
        },
        "进修副本使用工作证张数": {
            "type": "select",
            "label": "使用工作证张数",
            "cases": [
                {
                    "name": "1次",
                    "pipeline_override": {
                        "Flag_使用工作证弹窗": {
                            "next": [
                                "Click_工作证1张使用",
                                "Flag_工作证张数5张",
                                "[JumpBack]Click_工作证张数加号亮"
                            ]
                        },
                        "Flag_复盘确认弹窗": {
                            "next": [
                                "Click_复盘1次确定",
                                "Flag_复盘次数最小",
                                "[JumpBack]Click_复盘次数减号亮"
                            ]
                        },
                        "Flag_体力判断": {
                            "custom_recognition_param": {
                                "ap_threshold": 20
                            }
                        },
                        "Action_智能策略补充": {
                            "custom_action_param": {
                                "ap_threshold": 20
                            }
                        }
                    }
                },
                {
                    "name": "2次",
                    "pipeline_override": {
                        "Flag_使用工作证弹窗": {
                            "next": [
                                "Click_工作证2张使用",
                                "Flag_工作证张数5张",
                                "[JumpBack]Click_工作证张数加号亮"
                            ]
                        },
                        "Flag_复盘确认弹窗": {
                            "next": [
                                "Click_复盘2次确定",
                                "Flag_复盘次数最小",
                                "[JumpBack]Click_复盘次数减号亮"
                            ]
                        },
                        "Flag_体力判断": {
                            "custom_recognition_param": {
                                "ap_threshold": 40
                            }
                        },
                        "Action_智能策略补充": {
                            "custom_action_param": {
                                "ap_threshold": 40
                            }
                        }
                    }
                },
                {
                    "name": "3次",
                    "pipeline_override": {
                        "Flag_使用工作证弹窗": {
                            "next": [
                                "Click_工作证3张使用",
                                "Flag_工作证张数5张",
                                "[JumpBack]Click_工作证张数加号亮"
                            ]
                        },
                        "Flag_复盘确认弹窗": {
                            "next": [
                                "Click_复盘3次确定",
                                "Flag_复盘次数最小",
                                "[JumpBack]Click_复盘次数减号亮"
                            ]
                        },
                        "Flag_体力判断": {
                            "custom_recognition_param": {
                                "ap_threshold": 60
                            }
                        },
                        "Action_智能策略补充": {
                            "custom_action_param": {
                                "ap_threshold": 60
                            }
                        }
                    }
                },
                {
                    "name": "4次",
                    "pipeline_override": {
                        "Flag_使用工作证弹窗": {
                            "next": [
                                "Click_工作证4张使用",
                                "Flag_工作证张数5张",
                                "[JumpBack]Click_工作证张数加号亮"
                            ]
                        },
                        "Flag_复盘确认弹窗": {
                            "next": [
                                "Click_复盘4次确定",
                                "Flag_复盘次数最小",
                                "[JumpBack]Click_复盘次数减号亮"
                            ]
                        },
                        "Flag_体力判断": {
                            "custom_recognition_param": {
                                "ap_threshold": 80
                            }
                        },
                        "Action_智能策略补充": {
                            "custom_action_param": {
                                "ap_threshold": 80
                            }
                        }
                    }
                }
            ]
        }
    }
}
